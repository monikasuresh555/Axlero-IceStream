# ==========================================
# AI STUDIO SYSTEM CONFIGURATION
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"


# ==========================================
# ICESTREAM LOCAL DEVELOPEMENT SETTINGS
# ==========================================

# 1. STREAMING PLATFORM (KAFKA)
KAFKA_BOOTSTRAP_SERVERS="localhost:29092"
KAFKA_OBSERVABILITY_TOPIC="icestream.lakehouse.metrics"
KAFKA_CONSUMER_GROUP="icestream.gateway.consumers"

# 2. LAKEHOUSE ENGINE (ICEBERG REST CATALOG & STORAGE)
ICEBERG_CATALOG_URL="http://localhost:8181"
ICEBERG_WAREHOUSE_PATH="s3a://lakehouse/"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_CONSOLE_URL="http://localhost:9001"
MINIO_ROOT_USER="icestream_admin"
MINIO_ROOT_PASSWORD="icestream_password"

# 3. STREAM PROCESSING (FLINK)
FLINK_JOBMANAGER_HOST="localhost"
FLINK_JOBMANAGER_PORT="8081"
FLINK_DEFAULT_PARALLELISM="2"

# 4. BACKEND API & GATEWAY
EXPRESS_SERVER_PORT="3001"
WEBSOCKET_PORT="3001"

# 5. STREAM SIMULATION (DATA GENERATOR)
MOCK_DATA_INTERVAL_MS="1000"
MOCK_DATA_ANOMALY_RATE="0.05"
GREAT_EXPECTATIONS_SUITE_NAME="lakehouse_metrics_suite"
